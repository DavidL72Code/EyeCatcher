{
  "name": "thirdeye",
  "private": true,
  "description": "A post-game coach that watches your match recording and finds the one habit losing you games.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "electron desktop/main.mjs",
    "backend": "node server/index.mjs",
    "vendor": "node scripts/vendor.mjs",
    "scenes": "node scripts/make-scenes.mjs",
    "fixture": "node tests/make-fixture.mjs",
    "test:unit": "node --test tests/core.test.mjs tests/gemini-images.test.mjs tests/gemini-fallback.test.mjs tests/chess.test.mjs tests/backend.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:live": "node tests/live-check.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "eval": "node eval/run.mjs",
    "fixture:chess": "node tests/make-chess-fixture.mjs",
    "test:chess-video": "node tests/chess-video-check.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "electron": "44.9.0",
    "mediabunny": "1.61.0",
    "motion": "13.5.1",
    "playwright": "^1.56.0",
    "stockfish": "10.0.2"
  },
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=20"
  }
}
