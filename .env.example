# Copy this file to .env and put your own Gemini API key in it (https://aistudio.google.com/apikey).
# .env is git-ignored: it never leaves your machine, and Eye Catcher sends the key only to Google's Gemini API.
GEMINI_API_KEY=
# Optional: a second key (from another Google Cloud project) that takes over when the first runs out for the day.
GEMINI_API_KEY2=
